[Unit]
Description=Legion Control Daemon (fan/profile/RGB)
After=sysinit.target

[Service]
Type=simple
Environment=LEGION_LOG=info
ExecStart=/usr/bin/legion-daemon
Restart=on-failure
RestartSec=5

# Hardware access
DeviceAllow=char-hidraw rw
DeviceAllow=/dev/hidraw* rw
DeviceAllow=/dev/input/* rw
DeviceAllow=/dev/bus/usb/* rw
DeviceAllow=char-usb_device rw
# GPU telemetry: nvidia-smi needs the NVIDIA char devices; without these
# NVML init fails (exit 255) and dGPU temp/power report -1 in telemetry.
DeviceAllow=/dev/nvidia* rw
DeviceAllow=/dev/nvidiactl rw
DeviceAllow=/dev/nvidia-uvm-tools rw
DeviceAllow=char-nvidia-uvm rw
# Driver 610+ NVML needs nvidia-caps; path globs alone are ignored by systemd.
DeviceAllow=char-nvidia-caps rw
DeviceAllow=/dev/nvidia-caps/* rw
DeviceAllow=char-drm rw
ProtectSystem=false
ProtectHome=read-only
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
