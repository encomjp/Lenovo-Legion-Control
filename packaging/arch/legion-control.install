reload_udev() {
  # udevd may have parsed 99-legion.rules while pacman unpacked it, before
  # group 'legion' existed, and cached the rule without GROUP=. Bump the
  # mtime so --reload-rules really re-reads it, then apply and wait.
  for f in /usr/lib/udev/rules.d/99-legion.rules /etc/udev/rules.d/99-legion.rules; do
    [ -f "$f" ] && touch "$f"
  done
  udevadm control --reload-rules >/dev/null 2>&1 || true
  udevadm trigger --action=change -s hidraw >/dev/null 2>&1 || true
  udevadm settle -t 10 >/dev/null 2>&1 || true
}

post_install() {
  # IPC socket is 0660 root:legion — ensure the group exists (sysusers.d
  # normally handles this; this is a fallback for systems without the hook).
  getent group legion >/dev/null 2>&1 || groupadd -r legion >/dev/null 2>&1 || true
  if [ -d /run/systemd/system ]; then
    systemctl daemon-reload
    systemctl enable --now legion-control.service >/dev/null 2>&1 || true
  fi
  reload_udev
}

post_upgrade() {
  if [ -d /run/systemd/system ]; then
    systemctl daemon-reload
    systemctl try-restart legion-control.service >/dev/null 2>&1 || systemctl restart legion-control.service >/dev/null 2>&1 || true
    # Self-heal for in-app pacman -U under pkexec (minimal env): ensure active.
    systemctl is-active --quiet legion-control.service || systemctl start legion-control.service >/dev/null 2>&1 || true
  fi
  reload_udev
}

pre_remove() {
  if [ -d /run/systemd/system ]; then
    systemctl disable --now legion-control.service >/dev/null 2>&1 || true
  fi
}

post_remove() {
  if [ -d /run/systemd/system ]; then
    systemctl daemon-reload
  fi
}
