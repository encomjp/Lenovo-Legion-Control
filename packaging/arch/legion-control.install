reload_udev() {
  udevadm control --reload-rules >/dev/null 2>&1 || true
  udevadm trigger -s hidraw >/dev/null 2>&1 || true
}

post_install() {
  # IPC socket is 0660 root:legion — ensure the group exists (sysusers.d
  # normally handles this; this is a fallback for systems without the hook).
  getent group legion >/dev/null 2>&1 || groupadd -r legion >/dev/null 2>&1 || true
  if [ -d /run/systemd/system ]; then
    systemctl daemon-reload
    systemctl enable --now legion-control.service >/dev/null 2>&1 || true
  fi
  reload_udev
}

post_upgrade() {
  if [ -d /run/systemd/system ]; then
    systemctl daemon-reload
    systemctl try-restart legion-control.service >/dev/null 2>&1 || true
  fi
  reload_udev
}

pre_remove() {
  if [ -d /run/systemd/system ]; then
    systemctl disable --now legion-control.service >/dev/null 2>&1 || true
  fi
}

post_remove() {
  if [ -d /run/systemd/system ]; then
    systemctl daemon-reload
  fi
}
