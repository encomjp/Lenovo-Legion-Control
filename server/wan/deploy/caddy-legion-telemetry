# Legion Telemetry — Caddy site (WAN ingress, automatic HTTPS)
#
# Import from the main Caddyfile:   import /etc/caddy/legion-telemetry.caddy
# Requires $LEGION_WAN_DOMAIN DNS A/AAAA record → this server.
#
# WAN clients hit ONLY these two paths; the portal (port 8788) is never
# proxied here — it binds the Tailscale IP directly.

{$LEGION_WAN_DOMAIN} {
	encode zstd gzip

	# Only the ingest endpoint and health are exposed to the internet.
	handle /v1/diagnostics {
		reverse_proxy 127.0.0.1:8787
	}
	handle /health {
		reverse_proxy 127.0.0.1:8787
	}

	# Everything else → explicit 404 (no path discovery).
	handle {
		respond 404
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		-Server
	}
}
