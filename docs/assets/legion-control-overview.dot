digraph legion_control_overview {
    graph [
        rankdir=LR,
        bgcolor="#0c0a09",
        pad="0.18",
        nodesep="0.28",
        ranksep="0.55",
        splines=polyline,
        fontname="JetBrains Mono,ui-monospace,monospace",
        fontcolor="#e7e0d6",
        label="LEGION CONTROL  ·  bench console  ·  normal runtime path",
        labelloc=t,
        labeljust=l,
        fontsize=13
    ];

    node [
        shape=box,
        style="rounded,filled",
        fontname="Inter,ui-sans-serif,sans-serif",
        fontsize=9,
        margin="0.12,0.07",
        penwidth=1.2
    ];

    edge [
        fontname="JetBrains Mono,ui-monospace,monospace",
        fontsize=7.5,
        color="#6b7280",
        fontcolor="#9ca3af",
        penwidth=1.05,
        arrowsize=0.58
    ];

    subgraph cluster_userspace {
        label="OPERATOR";
        color="#c8102e";
        fontcolor="#fca5a5";
        style="rounded,dashed";
        cli [label="legion-cli", fillcolor="#450a0a", color="#c8102e", fontcolor="#fecaca"];
        settings [label="legion-settings  ·  GTK4", fillcolor="#450a0a", color="#c8102e", fontcolor="#fecaca"];
        kde [label="KDE widget", fillcolor="#450a0a", color="#c8102e", fontcolor="#fecaca"];
        cli -> settings [style=invis, weight=10];
        settings -> kde [style=invis, weight=10];
    }

    subgraph cluster_service {
        label="DAEMON / IPC";
        color="#6b7280";
        fontcolor="#d6d3d1";
        style="rounded,dashed";
        socket [label="Unix socket\n/run/legion-control.socket", fillcolor="#1c1917", color="#6b7280", fontcolor="#e7e5e4"];
        daemon [label="legion-daemon  ·  root", fillcolor="#292524", color="#a8a29e", fontcolor="#fafaf9"];
        socket -> daemon [label="bincode  ·  command / response", color="#a8a29e", fontcolor="#a8a29e"];
    }

    subgraph cluster_domains {
        label="CONTROL / TELEMETRY";
        color="#d9981a";
        fontcolor="#fde68a";
        style="rounded,dashed";
        controls [label="CONTROLS", fillcolor="#451a03", color="#d9981a", fontcolor="#fde68a"];
        telemetry [label="TELEMETRY", fillcolor="#451a03", color="#d9981a", fontcolor="#fde68a"];
        controls -> telemetry [style=invis, weight=10];
    }

    subgraph cluster_linux {
        label="LINUX INTERFACES";
        color="#78716c";
        fontcolor="#d6d3d1";
        style="rounded,dashed";
        sysfs [label="sysfs / hwmon\nplatform  ·  battery", fillcolor="#1c1917", color="#78716c", fontcolor="#e7e5e4"];
        wmi [label="WMI\nplatform", fillcolor="#1c1917", color="#78716c", fontcolor="#e7e5e4"];
        nvidia [label="nvidia-smi", fillcolor="#1c1917", color="#78716c", fontcolor="#e7e5e4"];
        hidraw [label="/dev/hidrawN  ·  USB HID", fillcolor="#1c1917", color="#78716c", fontcolor="#e7e5e4"];
        smu [label="optional  ·  ryzen_smu", fillcolor="#1c1917", color="#78716c", fontcolor="#e7e5e4"];
        sysfs -> wmi [style=invis, weight=10];
        wmi -> nvidia [style=invis, weight=10];
        nvidia -> hidraw [style=invis, weight=10];
        hidraw -> smu [style=invis, weight=10];
    }

    hardware [label="LEGION HARDWARE\nEC  ·  sensors  ·  Spectrum 048d:c197", fillcolor="#7f1d1d", color="#c8102e", fontcolor="#fecaca"];

    subgraph cluster_setup {
        label="SETUP";
        color="#57534e";
        fontcolor="#a8a29e";
        style="rounded,dashed";
        setup [label="legion-control-setup\nfixed actions", fillcolor="#1c1917", color="#57534e", fontcolor="#d6d3d1"];
        polkit [label="PolicyKit", fillcolor="#1c1917", color="#57534e", fontcolor="#d6d3d1"];
        setup -> polkit [label="authorize", color="#78716c", fontcolor="#78716c"];
    }

    cli -> socket [label="IPC  ·  read / write"];
    settings -> socket [label="IPC  ·  read / write"];
    kde -> cli [label="executes CLI", style=dashed, constraint=false, color="#78716c", fontcolor="#78716c"];

    daemon -> controls [label="read / write", color="#d9981a", fontcolor="#d9981a"];
    daemon -> telemetry [label="read", color="#d6d3d1", fontcolor="#a8a29e"];
    controls -> sysfs [label="write", color="#c8102e", fontcolor="#fca5a5"];
    controls -> wmi [label="write", color="#c8102e", fontcolor="#fca5a5"];
    telemetry -> sysfs [label="read"];
    telemetry -> wmi [label="read"];
    telemetry -> nvidia [label="read"];
    daemon -> hidraw [label="RGB / recovery", color="#57534e", fontcolor="#a8a29e"];
    daemon -> smu [label="read / write", color="#c8102e", fontcolor="#fca5a5"];
    sysfs -> hardware;
    wmi -> hardware;
    nvidia -> hardware;
    hidraw -> hardware;
    smu -> hardware;
}
