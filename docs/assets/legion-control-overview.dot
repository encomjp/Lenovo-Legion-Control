digraph legion_control_overview {
    graph [
        rankdir=LR,
        bgcolor="#0f172a",
        pad="0.18",
        nodesep="0.28",
        ranksep="0.5",
        splines=polyline,
        fontname="Inter,Arial,sans-serif",
        fontcolor="#e2e8f0",
        label="Lenovo Legion Control · normal runtime path",
        labelloc=t,
        labeljust=l,
        fontsize=18
    ];

    node [
        shape=box,
        style="rounded,filled",
        fontname="Inter,Arial,sans-serif",
        fontsize=9,
        margin="0.12,0.07",
        color="#334155",
        fontcolor="#f8fafc",
        penwidth=1.3
    ];

    edge [
        fontname="Inter,Arial,sans-serif",
        fontsize=8,
        color="#94a3b8",
        fontcolor="#cbd5e1",
        penwidth=1.15,
        arrowsize=0.62
    ];

    subgraph cluster_userspace {
        label="USER INTERFACES";
        color="#22d3ee";
        fontcolor="#67e8f9";
        style="rounded,dashed";
        cli [label="legion-cli", fillcolor="#155e75", color="#22d3ee"];
        settings [label="legion-settings\nGTK4", fillcolor="#155e75", color="#22d3ee"];
        kde [label="KDE widget", fillcolor="#155e75", color="#22d3ee"];
        cli -> settings [style=invis, weight=10];
        settings -> kde [style=invis, weight=10];
    }

    subgraph cluster_service {
        label="DAEMON / IPC";
        color="#a78bfa";
        fontcolor="#c4b5fd";
        style="rounded,dashed";
        socket [label="Unix socket\n/run/legion-control.socket", fillcolor="#312e81", color="#a78bfa"];
        daemon [label="legion-daemon\nusually root", fillcolor="#4c1d95", color="#a78bfa"];
        socket -> daemon [label="bincode command / response"];
    }

    subgraph cluster_domains {
        label="CONTROL / TELEMETRY";
        color="#f59e0b";
        fontcolor="#fbbf24";
        style="rounded,dashed";
        controls [label="Controls", fillcolor="#78350f", color="#f59e0b"];
        telemetry [label="Telemetry", fillcolor="#78350f", color="#f59e0b"];
        controls -> telemetry [style=invis, weight=10];
    }

    subgraph cluster_linux {
        label="LINUX INTERFACES";
        color="#38bdf8";
        fontcolor="#7dd3fc";
        style="rounded,dashed";
        sysfs [label="sysfs / hwmon\nplatform + battery", fillcolor="#075985", color="#38bdf8"];
        wmi [label="WMI\nplatform controls", fillcolor="#075985", color="#38bdf8"];
        nvidia [label="nvidia-smi", fillcolor="#075985", color="#38bdf8"];
        hidraw [label="/dev/hidrawN\nUSB HID", fillcolor="#075985", color="#38bdf8"];
        smu [label="optional\nryzen_smu", fillcolor="#075985", color="#38bdf8"];
        sysfs -> wmi [style=invis, weight=10];
        wmi -> nvidia [style=invis, weight=10];
        nvidia -> hidraw [style=invis, weight=10];
        hidraw -> smu [style=invis, weight=10];
    }

    hardware [label="Legion hardware\nEC · sensors · Spectrum keyboard", fillcolor="#92400e", color="#f59e0b"];

    subgraph cluster_setup {
        label="SETUP / POLICYKIT";
        color="#fb923c";
        fontcolor="#fdba74";
        style="rounded,dashed";
        setup [label="legion-control-setup\nfixed setup actions", fillcolor="#7c2d12", color="#fb923c"];
        polkit [label="PolicyKit\nauthentication", fillcolor="#7c2d12", color="#fb923c"];
        setup -> polkit [label="authorize"];
    }

    cli -> socket [label="Unix socket IPC\nread / write"];
    settings -> socket [label="Unix socket IPC\nread / write"];
    kde -> cli [label="executes CLI", style=dashed, constraint=false];

    daemon -> controls [label="read / write"];
    daemon -> telemetry [label="read"];
    controls -> sysfs [label="write", color="#fb923c", fontcolor="#fdba74"];
    controls -> wmi [label="write", color="#fb923c", fontcolor="#fdba74"];
    telemetry -> sysfs [label="read"];
    telemetry -> wmi [label="read"];
    telemetry -> nvidia [label="read"];
    daemon -> hidraw [label="RGB / recovery", color="#c084fc", fontcolor="#d8b4fe"];
    daemon -> smu [label="read / write", color="#fb923c", fontcolor="#fdba74"];
    sysfs -> hardware;
    wmi -> hardware;
    nvidia -> hardware;
    hidraw -> hardware;
    smu -> hardware;
}
