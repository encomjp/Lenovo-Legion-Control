digraph hid_lighting_flow {
    graph [
        label="LEGION HID LIGHTING  ·  source-verified path  ·  packet layout omitted",
        labelloc=t,
        labeljust=l,
        rankdir=LR,
        bgcolor="#0c0a09",
        fontname="JetBrains Mono,ui-monospace,monospace",
        fontsize=12,
        nodesep=0.25,
        ranksep=0.55,
        pad=0.2
    ];

    node [
        shape=box,
        style="rounded,filled",
        fontname="Inter,ui-sans-serif,sans-serif",
        fontsize=10,
        margin="0.14,0.09",
        penwidth=1.2
    ];

    edge [
        fontname="JetBrains Mono,ui-monospace,monospace",
        fontsize=8.5,
        color="#57534e",
        penwidth=1.05,
        arrowsize=0.66
    ];

    client [
        label="OPERATOR\nCLI  ·  settings  ·  widget (via CLI)",
        fillcolor="#450a0a",
        color="#c8102e",
        fontcolor="#fecaca"
    ];
    command_path [
        label="KEYBOARD MODULE\nlighting command",
        fillcolor="#292524",
        color="#78716c",
        fontcolor="#e7e5e4"
    ];
    hidraw [
        label="LINUX  ·  hidraw\n/dev/hidrawN",
        fillcolor="#1c1917",
        color="#57534e",
        fontcolor="#d6d3d1"
    ];
    spectrum [
        label="SPECTRUM RESPONDER\n048d:c197  ·  check 06 89 ff when available",
        fillcolor="#451a03",
        color="#d9981a",
        fontcolor="#fde68a"
    ];
    lighting [
        label="LIGHTING\nzones  ·  effects  ·  brightness  ·  logo",
        fillcolor="#7f1d1d",
        color="#c8102e",
        fontcolor="#fecaca"
    ];

    client -> command_path [label="request"];
    command_path -> hidraw [label="open /dev/hidrawN"];
    hidraw -> spectrum [label="feature report  ·  ID 0x07  ·  960 B"];
    spectrum -> lighting [label="apply"];

    subgraph cluster_legend {
        label="LEGEND";
        labelloc=t;
        labeljust=l;
        fontname="JetBrains Mono,ui-monospace,monospace";
        fontsize=8.5;
        color="#44403c";
        style="rounded,dashed";
        fontcolor="#a8a29e";

        legend_linux [
            label="Linux interface",
            fillcolor="#1c1917",
            color="#57534e",
            fontcolor="#d6d3d1",
            fontsize=8.5
        ];
        legend_project [
            label="Project behavior",
            fillcolor="#292524",
            color="#78716c",
            fontcolor="#e7e5e4",
            fontsize=8.5
        ];
        legend_hardware [
            label="Hardware path  ·  amber",
            fillcolor="#451a03",
            color="#d9981a",
            fontcolor="#fde68a",
            fontsize=8.5
        ];

        legend_linux -> legend_project [style=invis];
        legend_project -> legend_hardware [style=invis];
    }
}
