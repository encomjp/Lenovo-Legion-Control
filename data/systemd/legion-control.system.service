[Unit]
Description=Lenovo Legion Control Daemon (fan/profile/RGB)
After=sysinit.target

[Service]
Type=simple
Environment=LEGION_LOG=info
ExecStart=/usr/local/bin/legion-daemon
Restart=on-failure
RestartSec=5

# Hardware access — kept identical to packaging/common/legion-control.service;
# the units must differ only in the ExecStart prefix.
DeviceAllow=char-hidraw rw
DeviceAllow=/dev/hidraw* rw
DeviceAllow=/dev/input/* rw
DeviceAllow=/dev/bus/usb/* rw
DeviceAllow=char-usb_device rw
DeviceAllow=/dev/nvidia* rw
DeviceAllow=/dev/nvidiactl rw
DeviceAllow=char-nvidia-uvm rw
DeviceAllow=char-drm rw
ProtectSystem=false
ProtectHome=read-only
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
