# Lenovo Legion — allow userspace access to ec_sys and keyboard HID
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="048d", ATTRS{idProduct}=="c193", MODE="0660", GROUP="legion", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="048d", ATTRS{idProduct}=="c197", MODE="0660", GROUP="legion", TAG+="uaccess"
# ITE 8258/8295 lighting controllers: c1xx (Gen 10+), c6xx (LOQ / Legion 5 Gen 11), c9xx (older).
# Access only; the app writes to a device only after its HID descriptor confirms a known protocol.
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="048d", ATTRS{idProduct}=="c1??", MODE="0660", GROUP="legion", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="048d", ATTRS{idProduct}=="c6??", MODE="0660", GROUP="legion", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="048d", ATTRS{idProduct}=="c9??", MODE="0660", GROUP="legion", TAG+="uaccess"
